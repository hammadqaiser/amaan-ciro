# Vercel AI Gateway (Primary Gateway)
# Run `npx vercel ai-gateway setup` or create a key at https://vercel.com/ai/gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# Best free/fast models: google/gemini-2.0-flash, meta-llama/llama-3.3-70b-instruct, deepseek/deepseek-chat
AI_GATEWAY_MODEL=google/gemini-2.0-flash

# Fallback LLM Providers (Optional)
GEMINI_API_KEY=
GROQ_API_KEY=
